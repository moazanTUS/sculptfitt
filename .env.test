# Test environment variables
# Copy this to .env.test and fill in test values

# Test Database (use separate test database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=test_user
DB_PASS=test_password
DB_NAME=sculpfit_test

# Test API Keys (use free tier keys for testing)
GEMINI_API_KEY=test_key_for_mocking
CLERK_SECRET_KEY=test_clerk_key

# Test CORS
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Disable rate limiting in tests
RATE_LIMIT_ENABLED=false
